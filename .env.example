# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# A Firebase web config is not a secret, but keep production keys out of source control anyway.
# If these are left empty, PlainTerms runs in demo mode: routing, the red-flag scan and
# history all work locally, and answers come from the built-in local fallback engine.
VITE_FIREBASE_API_KEY=
<redacted>
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise site key). App Check is always initialized when a
# project is configured, because Firebase AI Logic enforces it. On localhost /
# 127.0.0.1 you can leave this empty: the debug-token flow is used instead — the SDK
# prints a debug token in the browser console; register it under
# Firebase console > App Check > Apps > Manage debug tokens.
# On a real host, a site key is required, or cloud calls will be rejected.
VITE_APPCHECK_SITE_KEY=
# Optional: set to "true" to point Auth and Firestore at the local Firebase
# emulators (firebase emulators:start). AI Logic and App Check are not emulated.
VITE_USE_EMULATORS=
